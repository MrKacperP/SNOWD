rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null
        && !firestore.exists(/databases/(default)/documents/accountDeletionTombstones/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdminOrEmployee() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ["admin", "employee"];
    }

    // ID documents - users can upload their own, admin can read all
    match /id-documents/{userId}/{allPaths=**} {
      allow read, write: if isSelf(userId) || isAdminOrEmployee();
    }
    
    // Verification files (ID photos, transcripts from settings page)
    match /verification/{userId}/{allPaths=**} {
      allow read, write: if isSelf(userId) || isAdminOrEmployee();
    }
    
    // Student transcripts
    match /transcripts/{userId}/{allPaths=**} {
      allow read, write: if isSelf(userId) || isAdminOrEmployee();
    }
    
    // Branding assets (logo, portfolio via settings page)
    match /branding/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(userId);
    }

    // Portfolio photos
    match /portfolio/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(userId);
    }
    
    // Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSelf(userId);
    }

    // Client property photos shown only to signed-in marketplace participants.
    match /property-photos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }
    
    // Completion photos for jobs
    match /completion-photos/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    // Full-size photos sent in chat from the native app.
    match /chat-photos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId) && request.resource.size < 25 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    // Default: deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

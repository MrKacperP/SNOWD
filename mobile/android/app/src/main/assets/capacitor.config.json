{
	"appId": "ca.snowd.app",
	"appName": "SNOWD",
	"webDir": "www",
	"server": {
		"url": "https://www.snowd.ca/mobile",
		"errorPath": "offline.html",
		"cleartext": false
	},
	"ios": {
		"contentInset": "never",
		"backgroundColor": "#f4f7fa",
		"preferredContentMode": "mobile"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"google.com",
				"apple.com"
			]
		}
	}
}

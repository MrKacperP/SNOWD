rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOwnUserDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper: caller is admin or employee
    function isAdminOrEmployee() {
      return hasOwnUserDoc() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "employee"];
    }

    function isAdmin() {
      return hasOwnUserDoc() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function changedUserKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function selfCanUpdateUser(userId) {
      return isSelf(userId)
        && !changedUserKeys().hasAny([
          "role",
          "stripeConnectAccountId",
          "stripeAccountStatus",
          "stripeReady",
          "accountApproved",
          "idVerified",
          "verificationNote",
          "verificationReasonCategory",
          "approvedAt",
          "rejectedAt",
          "approvedByAdmin",
          "reviewedByAdminUid",
          "employeePermissions",
          "addedByAdmin"
        ])
        && (!changedUserKeys().hasAny(["verificationStatus"]) || request.resource.data.verificationStatus in ["pending", "not-submitted"]);
    }

    // Generic participant helper to support multiple schema shapes.
    function isParticipant(data) {
      return isSignedIn() && data != null && (
        isAdminOrEmployee() ||
        (data.get("participants", []) is list && request.auth.uid in data.get("participants", [])) ||
        (data.get("participantIds", []) is list && request.auth.uid in data.get("participantIds", [])) ||
        (data.get("members", []) is list && request.auth.uid in data.get("members", [])) ||
        (data.get("userIds", []) is list && request.auth.uid in data.get("userIds", [])) ||
        (data.get("clientId", "") == request.auth.uid) ||
        (data.get("operatorId", "") == request.auth.uid) ||
        (data.get("uid", "") == request.auth.uid) ||
        (data.get("createdBy", "") == request.auth.uid)
      );
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Private-by-default user documents.
      allow read: if isSelf(userId);
      allow read: if isAdminOrEmployee();
      allow read: if isSignedIn() && resource.data.role in ["client", "operator"];
      allow create: if isAdminOrEmployee() || (isSelf(userId) &&
        request.resource.data.role in ["client", "operator"] &&
        (request.resource.data.role == "client" || request.resource.data.get("idVerified", false) == false) &&
        request.resource.data.get("stripeConnectAccountId", "") == "" &&
        request.resource.data.get("stripeAccountStatus", "pending") != "connected" &&
        request.resource.data.get("stripeReady", false) == false);
      allow delete: if isSelf(userId) || isAdminOrEmployee();
      allow update: if isAdminOrEmployee() || selfCanUpdateUser(userId);
    }

    // Retains account continuity when a user starts over with the same email.
    match /accountHistory/{historyId} {
      allow read: if isAdminOrEmployee() ||
        (isSignedIn() && request.auth.token.email == resource.data.email);
      allow create: if isSignedIn() && request.auth.token.email == request.resource.data.email;
      allow update: if isSignedIn() && request.auth.token.email == resource.data.email &&
        request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    // ── Admin Activity (append-only audit log) ────────────────────────────
    match /adminActivity/{eventId} {
      allow read: if isAdminOrEmployee();
      allow create: if isAdminOrEmployee();
      allow update, delete: if isAdmin();
    }

    function verifiedJobOperator(data) {
      return get(/databases/$(database)/documents/users/$(data.operatorId)).data.idVerified == true;
    }

    function jobPaymentAllowed(data) {
      let operator = get(/databases/$(database)/documents/users/$(data.operatorId)).data;
      return data.paymentMethod == "cash" ||
        (operator.get("stripeAccountStatus", "pending") == "connected" &&
         operator.get("stripeConnectAccountId", "") != "");
    }

    // ── Jobs ───────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read:   if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data) && verifiedJobOperator(request.resource.data) && jobPaymentAllowed(request.resource.data)
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "pending"
        && request.resource.data.get("stripePaymentIntentId", "") == ""
        && !request.resource.data.keys().hasAny(["cashConfirmedBy", "cashConfirmedAt", "cashPaymentDeferredAt", "cashRefundedBy", "cashRefundedAt"]);
      allow update: if isParticipant(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["clientId", "operatorId", "stripePaymentIntentId", "paymentCapturedAt", "paymentMethod", "cashConfirmedBy", "cashConfirmedAt", "cashPaymentDeferredAt", "cashRefundedBy", "cashRefundedAt", "paymentStatus"])
        && (resource.data.paymentMethod == "cash" && resource.data.get("stripePaymentIntentId", "") == "" ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["paymentStatus", "price"]))
        && (resource.data.paymentStatus != "paid" || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["price"]))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) || request.resource.data.status != "completed" ||
          (resource.data.paymentMethod != "cash" && request.auth.uid == resource.data.operatorId && request.resource.data.get("completionPhotoUrl", "") != "" && resource.data.paymentStatus == "paid"))
        && (request.resource.data.status != "accepted" ||
          (verifiedJobOperator(request.resource.data) && jobPaymentAllowed(request.resource.data)));
      allow delete: if isAdmin();
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read:   if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data);
      allow update: if isParticipant(resource.data);
      allow delete: if isParticipant(resource.data) || isAdmin();
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        isAdminOrEmployee() ||
        (resource.data.chatId is string &&
          isParticipant(get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data)) ||
        (resource.data.senderId is string && resource.data.senderId == request.auth.uid)
      );
      allow create: if isSignedIn() && (
        isAdminOrEmployee() ||
        (request.resource.data.senderId is string &&
          request.resource.data.senderId in [request.auth.uid, "system"])
      ) &&
      (request.resource.data.chatId is string &&
        isParticipant(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data));
      allow update: if isAdminOrEmployee() ||
        (
          resource.data.chatId is string &&
          isParticipant(get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]) &&
          request.resource.data.read == true
        ) ||
        (resource.data.senderId is string && resource.data.senderId == request.auth.uid);
      allow delete: if isAdminOrEmployee() ||
        (resource.data.senderId is string && resource.data.senderId == request.auth.uid);
    }

    // ── Reviews ────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isSignedIn() && (
        isAdminOrEmployee() ||
        request.auth.uid == resource.data.reviewerId ||
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.operatorId
      );
      allow create: if isSignedIn() && (
        isAdminOrEmployee() ||
        request.auth.uid == request.resource.data.reviewerId
      );
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.reviewerId ||
         request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.operatorId ||
         isAdminOrEmployee());
      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.reviewerId ||
         request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.operatorId ||
         isAdminOrEmployee());
    }

    // ── Transactions ───────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read:   if isParticipant(resource.data);
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ── Claims ─────────────────────────────────────────────────────────────
    match /claims/{claimId} {
      allow read: if isSignedIn() &&
        (isAdminOrEmployee() || request.auth.uid == resource.data.claimantId);
      allow create: if isSignedIn() &&
        (isAdminOrEmployee() || request.auth.uid == request.resource.data.claimantId);
      allow update: if isSignedIn() &&
        (request.auth.uid == resource.data.claimantId || isAdminOrEmployee());
      allow delete: if isAdmin();
    }

    // ── Support Chats ──────────────────────────────────────────────────────
    match /supportChats/{chatId} {
      allow read, write: if isSignedIn() &&
        (chatId == ('support_' + request.auth.uid) || isAdminOrEmployee());

      match /messages/{messageId} {
        allow read, write: if isSignedIn() &&
          (chatId == ('support_' + request.auth.uid) || isAdminOrEmployee());
      }
    }

    // ── Admin Notifications ─────────────────────────────────────────────────
    match /adminNotifications/{notifId} {
      allow create: if
        (
          request.auth == null &&
          request.resource.data.type == 'visit' &&
          (!('uid' in request.resource.data) || request.resource.data.uid == null)
        ) ||
        (
          isSignedIn() &&
          (
            !('uid' in request.resource.data) ||
            request.resource.data.uid == null ||
            request.resource.data.uid == request.auth.uid
          )
        );
      allow read, update: if isAdminOrEmployee();
      allow delete: if isAdmin();
    }

    // ── User Notifications (approval / rejection notices) ──────────────────
    match /notifications/{notifId} {
      // Users can read & update their own notifications; admin can read/write all
      allow read, update: if isSignedIn() &&
        (request.auth.uid == resource.data.uid || isAdminOrEmployee());
      allow create: if isAdminOrEmployee();
      allow delete: if isAdmin();
    }

    // ── Site Visits ────────────────────────────────────────────────────────
    match /siteVisits/{visitId} {
      allow create: if isSignedIn() &&
        (
          !('uid' in request.resource.data) ||
          request.resource.data.uid == null ||
          request.resource.data.uid == request.auth.uid
        );
      allow read:   if isAdminOrEmployee();
      allow delete: if isAdmin();
    }
  }
}
